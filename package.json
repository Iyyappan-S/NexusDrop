{
  "name": "nexusdrop",
  "private": true,
  "type": "module",
  "scripts": {"dev": "concurrently -k -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"", "dev:backend": "npm --prefix backend run dev", "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0", "build": "npm --prefix frontend run build", "test": "npm --prefix backend test && npm --prefix frontend test", "start": "npm --prefix backend start"},
  "devDependencies": {"concurrently": "^9.1.2"}
}
